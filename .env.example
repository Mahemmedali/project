# --- Sayt ---
NEXT_PUBLIC_SITE_URL=https://goodmorningbaku.com

# --- Payload CMS (Mərhələ 2) ---
# Neon: postgres://user:pass@ep-xxx.eu-central-1.aws.neon.tech/gmb?sslmode=require
DATABASE_URI=postgres://postgres@localhost:5433/gmb
PAYLOAD_SECRET=change-me-32-chars-random
PREVIEW_SECRET=change-me-preview

# --- Cloudflare R2 (media) — boş qalsa fayllar lokal public/media qovluğuna yazılır ---
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=            # məs. https://media.goodmorningbaku.com

# --- E-poçt (Resend) — boş qalsa məktublar konsola yazılır ---
RESEND_API_KEY=
EMAIL_FROM="Good Morning Baku <hello@goodmorningbaku.com>"
SALES_EMAIL=reklam@goodmorningbaku.com

# --- Anti-spam (Cloudflare Turnstile) — istəyə görə ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Cron (Vercel) ---
CRON_SECRET=change-me-cron

# --- Seed (yalnız ilk quraşdırma) ---
SEED_ADMIN_EMAIL=admin@goodmorningbaku.com
SEED_ADMIN_PASSWORD=change-me

# Analitika (istəyə görə)
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
NEXT_PUBLIC_GA_ID=
